# ============================================================================
# Copy this file to `.env` and replace every CHANGE_ME. The client secrets and
# demo password here MUST match the ones in keycloak/realm-export.json.
# Generate strong random values with:  openssl rand -hex 24
# ============================================================================

# --- Realm / public URLs ---
REALM=llmdemo

# IMPORTANT (local dev): so that the `iss` in tokens is identical whether the
# browser or a container issues them, use the hostname `keycloak` everywhere and
# add this line to your machine's /etc/hosts:
#     127.0.0.1   keycloak
PUBLIC_KEYCLOAK_URL=http://keycloak:8080
PUBLIC_OPENWEBUI_URL=http://localhost:3000

# --- Keycloak admin console (http://keycloak:8080  ->  admin / ...) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Secrets shared with realm-export.json (must match exactly) ---
OPENWEBUI_CLIENT_SECRET=CHANGE_ME_openwebui_client_secret   # -> realm client "open-webui".secret
LLMCLI_CLIENT_SECRET=CHANGE_ME_llmcli_client_secret         # -> realm client "llm-cli".secret
DEMO_USER_PASSWORD=CHANGE_ME_demo_password                  # -> realm user "demo" password

# --- Internal secrets (not exposed publicly) ---
LITELLM_MASTER_KEY=sk-CHANGE_ME_litellm_internal_key
GATEWAY_SERVICE_TOKEN=CHANGE_ME_service_token_for_webui

# --- Langfuse (LLM observability) ---
# These are NOT generated by setup.sh — create a project in your Langfuse
# instance, then Settings -> API Keys, and paste the pair here.
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_FROM_LANGFUSE_UI
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_FROM_LANGFUSE_UI
# Where LiteLLM reaches Langfuse. Use the server's LAN IP so the litellm
# container can reach it (Langfuse runs as a separate stack), or localhost
# if Langfuse runs on the same host and you only call from there.
LANGFUSE_BASE_URL=http://<SERVER_IP>:3001
